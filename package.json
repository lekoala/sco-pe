{
  "name": "@lekoala/sco-pe",
  "version": "0.2.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Scoped navigation custom element, progressively enhances links and forms in server-rendered apps",
  "type": "module",
  "main": "sco-pe.js",
  "files": [
    "sco-pe.js",
    "src",
    "dist",
    "README.md",
    "LICENSE",
    "docs",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": "./sco-pe.js",
    "./src/Scope.js": "./src/Scope.js",
    "./dist/sco-pe.min.js": "./dist/sco-pe.min.js",
    "./dist/sco-pe.js": "./dist/sco-pe.js"
  },
  "packageManager": "bun@1.4.2",
  "sideEffects": [
    "./sco-pe.js",
    "./dist/*.js"
  ],
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "check": "node --check sco-pe.js && node --check src/*.js && node --check tests/fixtures/server.mjs && node --check demo-server.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "serve": "node tests/fixtures/server.mjs",
    "demo": "node demo-server.mjs",
    "build": "bun scripts/build.js",
    "verify": "bun run check && bun run lint && bun run build",
    "prepublishOnly": "bun run check && bun run test && bun run build"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@biomejs/biome": "2.5.14"
  },
  "keywords": [
    "custom-elements",
    "html",
    "fetch",
    "navigation",
    "ajax",
    "progressive-enhancement"
  ],
  "author": "LeKoala",
  "license": "MIT"
}
